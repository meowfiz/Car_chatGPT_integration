# Copy to %USERPROFILE%\.claude\ask_bridge.env and fill in. NEVER commit the real file
# (ZASADY 2.5 / monitor.env precedent): ASK_SECRET is the whole authentication of the bridge.

# Long random string; it lands in the URL used by the iPhone shortcut.
# Generate: powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
ASK_SECRET=

# Where the repositories live ON THIS MACHINE. They do not have to share a parent and they
# sit elsewhere on every machine, so this is per machine, never in the repo.
#   ASK_REPOS - explicit ';' separated list of absolute paths (wins over ASK_ROOT)
#   ASK_ROOT  - fallback: every git checkout directly under this directory
# Generate the ASK_REPOS line with: powershell -File .ind_repos.ps1
ASK_REPOS=
ASK_ROOT=D:\claude_projects

# Freshness: before every answer the bridge fast-forwards each repository (never pushes,
# never touches a dirty tree) and tells the model how old the data is. 0 disables.
ASK_SYNC=1
ASK_SYNC_TIMEOUT=8

# Empty = take the Tailscale IPv4 of this machine at start time (recommended).
ASK_BIND=
ASK_PORT=8787

ASK_MODEL=sonnet
ASK_TIMEOUT=120
ASK_WHISPER=small
ASK_WHISPER_DEVICE=cpu

# Watchdog: minutes between deep checks (real question through claude). 0 disables.
ASK_DEEP_MIN=60

# Optional Home Assistant webhook, called when the watchdog restarts or a deep check fails.
# Example: https://<ha-host>/api/webhook/<id>
HA_NOTIFY_URL=
