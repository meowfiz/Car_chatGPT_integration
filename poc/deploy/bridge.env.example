# Copy to %USERPROFILE%\.claude\ask_bridge.env and fill in. NEVER commit the real file
# (ZASADY 2.5 / monitor.env precedent): ASK_SECRET is the whole authentication of the bridge.

# Long random string; it lands in the URL used by the iPhone shortcut.
# Generate: powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
ASK_SECRET=

# Where the repositories live on the work PC.
ASK_ROOT=D:\claude_projects

# Empty = take the Tailscale IPv4 of this machine at start time (recommended).
ASK_BIND=
ASK_PORT=8787

ASK_MODEL=sonnet
ASK_TIMEOUT=120
ASK_WHISPER=small
ASK_WHISPER_DEVICE=cpu

# Watchdog: minutes between deep checks (real question through claude). 0 disables.
ASK_DEEP_MIN=60

# Optional Home Assistant webhook, called when the watchdog restarts or a deep check fails.
# Example: https://<ha-host>/api/webhook/<id>
HA_NOTIFY_URL=
